# ==============================================================================
# Universal CRM — Environment Configuration Matrix
#
# Classification:
#   [REQUIRED IN PRODUCTION] : Mandatory for production. App fails closed without it.
#   [OPTIONAL IN DEVELOPMENT]: Has default or dev fallback for local offline hacking.
#   [TEST-ONLY]             : Specific to unit/integration testing suites.
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] PostgreSQL connection string (pooled or direct)
DATABASE_URL="postgresql://postgres:password@localhost:5432/universal_crm_dev"

# [TEST-ONLY] PostgreSQL connection string for running test suites.
# Required for positive test database identification during test execution.
# Test suite fails closed if TEST_DATABASE_URL is not set.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/universal_crm_dev"

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Public base URL of the application without trailing slash (HTTPS in production, e.g. https://crm.yourdomain.com).
# Must not point to localhost in production. NEXT_PUBLIC_APP_URL is NOT accepted as a production fallback.
APP_URL="http://localhost:3000"
# [REQUIRED IN PRODUCTION] Node runtime environment ("production" | "development" | "test")
NODE_ENV="development"

# ------------------------------------------------------------------------------
# SESSION / AUTH (DB-Backed Sessions with Instant Revocation — DECISION-001)
# ------------------------------------------------------------------------------
# [OPTIONAL] Session cookie duration in seconds (defaults to 86400 = 24 hours)
SESSION_MAX_AGE_SECONDS="86400"

# ------------------------------------------------------------------------------
# SUPER ADMIN SEED
# ------------------------------------------------------------------------------
# [OPTIONAL IN DEVELOPMENT] Initial super admin credentials seeded on prisma db seed
SEED_SUPER_ADMIN_EMAIL="superadmin@universalcrm.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe@SuperAdmin123!"
SEED_SUPER_ADMIN_NAME="Super Admin"

# ------------------------------------------------------------------------------
# EMAIL SERVICE (Resend)
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Active provider: "resend" in production; "mock" permitted in dev/test only
EMAIL_PROVIDER="resend"
# [REQUIRED IN PRODUCTION] Valid sender email address for all transactional emails
EMAIL_FROM_ADDRESS="noreply@universalcrm.com"
# [OPTIONAL IN DEVELOPMENT] Backward-compatible fallback alias for EMAIL_FROM_ADDRESS
EMAIL_FROM="noreply@universalcrm.com"
# [REQUIRED IN PRODUCTION] Resend API key for delivering real transactional emails
RESEND_API_KEY=""

# ------------------------------------------------------------------------------
# FILE STORAGE (Cloudflare R2 / S3-Compatible)
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Active provider: "r2" in production; "local" permitted in dev/test only
STORAGE_PROVIDER="r2"
# [REQUIRED IN PRODUCTION] Cloudflare R2 / S3 bucket name for CRM file storage
STORAGE_BUCKET="universal-crm"
# [REQUIRED IN PRODUCTION] Cloudflare R2 / S3 API access key ID with read/write permissions
STORAGE_ACCESS_KEY=""
# [REQUIRED IN PRODUCTION] Cloudflare R2 / S3 API secret access key
STORAGE_SECRET_KEY=""
# [REQUIRED IN PRODUCTION] Cloudflare R2 S3-compatible API endpoint URL (https://<account_id>.r2.cloudflarestorage.com)
STORAGE_ENDPOINT=""
# [OPTIONAL IN DEVELOPMENT] Storage region (defaults to "auto" for Cloudflare R2)
STORAGE_REGION="auto"
# [OPTIONAL IN DEVELOPMENT] Filesystem storage directory path used ONLY when STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# ------------------------------------------------------------------------------
# RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Active provider: "upstash" in production; "memory" permitted in dev/test only
RATE_LIMIT_PROVIDER="upstash"
# [REQUIRED IN PRODUCTION] Upstash Redis REST API URL for distributed sliding-window rate limiting
UPSTASH_REDIS_REST_URL=""
# [REQUIRED IN PRODUCTION] Upstash Redis REST API token for authenticating sliding-window requests
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# [OPTIONAL] Log level: "debug" | "info" | "warn" | "error" (defaults to "info" in production, "debug" in dev)
LOG_LEVEL="info"
# [OPTIONAL] Request duration threshold in milliseconds before triggering a SLOW_REQUEST warning (defaults to 1000ms)
SLOW_REQUEST_MS="1000"
# [OPTIONAL] Toggle automatic HTTP request observation logging (defaults to true)
ENABLE_REQUEST_LOGGING="true"
