{
  "name": "universal-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:phase-lock && next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "node -e 'if(process.argv.includes(\"--force-reset\")){console.error(\"❌ BLOCKED: force-reset is forbidden via prisma:push\");process.exit(1)}' && prisma db push",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "test": "npm run check:phase-lock && ts-node -r tsconfig-paths/register --project tsconfig.seed.json tests/run-all.ts",
    "test:e2e": "ts-node -r tsconfig-paths/register --project tsconfig.seed.json tests/http-e2e.test.ts",
    "customer-backfill": "ts-node -r tsconfig-paths/register --project tsconfig.seed.json scripts/customer-backfill.ts",
    "onboarding-backfill": "ts-node -r tsconfig-paths/register --project tsconfig.seed.json scripts/onboarding-backfill.ts",
    "deploy:prepare": "npm run check:phase-lock && prisma migrate deploy && npm run onboarding-backfill -- --apply",
    "check:phase-lock": "ts-node -r tsconfig-paths/register --project tsconfig.seed.json scripts/check-phase-locks.ts",
    "db:reset": "node scripts/guard-db-reset.js && prisma migrate reset --force && npm run seed"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@base-ui/react": "^1.8.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/client": "^5.22.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.30.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
